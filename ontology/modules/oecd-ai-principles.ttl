@prefix asgo:    <https://w3id.org/asgo/core#> .
@prefix oecd:    <https://w3id.org/asgo/oecd-ai#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =============================================================================
# OECD Recommendation of the Council on Artificial Intelligence
# (OECD/LEGAL/0449) - "OECD AI Principles"
# Adopted 22 May 2019, revised 3 May 2024.
# The values-based principles are the common ancestor of many AI policies and
# of the AI system definition used in the EU AI Act (Art. 3(1)) and NIST.
# Mappings at the end of this file are author-curated.
# =============================================================================

<https://w3id.org/asgo/oecd-ai>
    a owl:Ontology ;
    owl:imports <https://w3id.org/asgo/core> ;
    dcterms:title "ASGO - OECD AI Principles module"@en ;
    owl:versionInfo "0.1.0" .

oecd:AIPrinciples a asgo:Framework ;
    rdfs:label "OECD AI Principles (Recommendation of the Council on Artificial Intelligence)"@en ;
    asgo:identifier "OECD/LEGAL/0449" ;
    asgo:authorityLevel asgo:Voluntary ;
    asgo:sourceURL "https://oecd.ai/en/ai-principles" ;
    rdfs:seeAlso <https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0449> ;
    dcterms:issued "2019-05-22"^^xsd:date ;
    dcterms:modified "2024-05-03"^^xsd:date ;
    asgo:publicationStatus asgo:Final ;
    asgo:statusCheckedOn "2026-10-01"^^xsd:date ;
    skos:note "Intergovernmental standard adhered to by OECD members and partner countries. The 2024 revision added explicit attention to misinformation/disinformation, human agency and oversight, misuse outside intended purpose, and environmental sustainability, and updated the AI system definition."@en .

oecd:ValuesBasedPrinciple a owl:Class ; rdfs:subClassOf asgo:FrameworkElement ;
    rdfs:label "OECD values-based principle"@en ;
    skos:definition "Principle addressed to all AI actors (Section 1)."@en .

oecd:PolicyRecommendation a owl:Class ; rdfs:subClassOf asgo:FrameworkElement ;
    rdfs:label "OECD recommendation for policy makers"@en ;
    skos:definition "Recommendation addressed to governments (Section 2); not an organisational control."@en .

# -----------------------------------------------------------------------------
# Section 1 - Values-based principles for all AI actors
# -----------------------------------------------------------------------------

oecd:P1.1 a oecd:ValuesBasedPrinciple ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "oecd.ai principles page and 2024 update summaries" ; asgo:identifier "OECD 1.1" ; asgo:partOfFramework oecd:AIPrinciples ;
    rdfs:label "OECD 1.1 Inclusive growth, sustainable development and well-being"@en ;
    skos:scopeNote "AI should benefit people and the planet: inclusion, reducing inequalities, protecting natural environments."@en .

oecd:P1.2 a oecd:ValuesBasedPrinciple ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "oecd.ai principles page and 2024 update summaries" ; asgo:identifier "OECD 1.2" ; asgo:partOfFramework oecd:AIPrinciples ;
    rdfs:label "OECD 1.2 Respect for the rule of law, human rights and democratic values, including fairness and privacy"@en ;
    skos:historyNote "Titled 'Human-centred values and fairness' in the 2019 version."@en ;
    skos:scopeNote "Non-discrimination, privacy and data protection, dignity, autonomy, labour rights; addressing AI-amplified mis/disinformation; safeguards such as human agency and oversight, including against misuse outside the intended purpose."@en .

oecd:P1.3 a oecd:ValuesBasedPrinciple ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "oecd.ai principles page and 2024 update summaries" ; asgo:identifier "OECD 1.3" ; asgo:partOfFramework oecd:AIPrinciples ;
    rdfs:label "OECD 1.3 Transparency and explainability"@en ;
    skos:scopeNote "Meaningful information so people know they interact with AI, understand outputs, and can challenge them."@en .

oecd:P1.4 a oecd:ValuesBasedPrinciple ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "oecd.ai principles page and 2024 update summaries" ; asgo:identifier "OECD 1.4" ; asgo:partOfFramework oecd:AIPrinciples ;
    rdfs:label "OECD 1.4 Robustness, security and safety"@en ;
    skos:scopeNote "AI should function appropriately under normal use, foreseeable use or misuse, and adverse conditions; mechanisms to override, repair or decommission safely when it risks undue harm."@en .

oecd:P1.5 a oecd:ValuesBasedPrinciple ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "oecd.ai principles page and 2024 update summaries" ; asgo:identifier "OECD 1.5" ; asgo:partOfFramework oecd:AIPrinciples ;
    rdfs:label "OECD 1.5 Accountability"@en ;
    skos:scopeNote "AI actors are accountable for proper functioning, ensure traceability (datasets, processes, decisions) and apply systematic risk management across the lifecycle."@en .

# -----------------------------------------------------------------------------
# Section 2 - Recommendations for policy makers
# -----------------------------------------------------------------------------

oecd:R2.1 a oecd:PolicyRecommendation ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "oecd.ai principles page and 2024 update summaries" ; asgo:identifier "OECD 2.1" ; asgo:partOfFramework oecd:AIPrinciples ;
    rdfs:label "OECD 2.1 Investing in AI research and development"@en .
oecd:R2.2 a oecd:PolicyRecommendation ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "oecd.ai principles page and 2024 update summaries" ; asgo:identifier "OECD 2.2" ; asgo:partOfFramework oecd:AIPrinciples ;
    rdfs:label "OECD 2.2 Fostering an inclusive AI-enabling ecosystem"@en .
oecd:R2.3 a oecd:PolicyRecommendation ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "oecd.ai principles page and 2024 update summaries" ; asgo:identifier "OECD 2.3" ; asgo:partOfFramework oecd:AIPrinciples ;
    rdfs:label "OECD 2.3 Shaping an enabling interoperable governance and policy environment for AI"@en .
oecd:R2.4 a oecd:PolicyRecommendation ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "oecd.ai principles page and 2024 update summaries" ; asgo:identifier "OECD 2.4" ; asgo:partOfFramework oecd:AIPrinciples ;
    rdfs:label "OECD 2.4 Building human capacity and preparing for labour market transition"@en .
oecd:R2.5 a oecd:PolicyRecommendation ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "oecd.ai principles page and 2024 update summaries" ; asgo:identifier "OECD 2.5" ; asgo:partOfFramework oecd:AIPrinciples ;
    rdfs:label "OECD 2.5 International co-operation for trustworthy AI"@en .

# Mappings to NIST AI RMF and the EU AI Act: mappings/framework-crosswalk.ttl
