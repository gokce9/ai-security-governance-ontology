# -----------------------------------------------------------------------------

threat:LLM01-2025 a asgo:FrameworkElement ; asgo:verificationStatus asgo:VerifiedPrimary ; asgo:verifiedWith "genai.owasp.org/llm-top-10" ; asgo:partOfFramework threat:OWASPLLMTop10-2025 ; asgo:identifier "LLM01:2025" ; rdfs:label "LLM01:2025 Prompt Injection"@en ; asgo:addresses threat:PromptInjection .
threat:LLM02-2025 a asgo:FrameworkElement ; asgo:verificationStatus asgo:VerifiedPrimary ; asgo:verifiedWith "genai.owasp.org/llm-top-10" ; asgo:partOfFramework threat:OWASPLLMTop10-2025 ; asgo:identifier "LLM02:2025" ; rdfs:label "LLM02:2025 Sensitive Information Disclosure"@en ; asgo:addresses threat:DataReconstruction .
threat:LLM03-2025 a asgo:FrameworkElement ; asgo:verificationStatus asgo:VerifiedPrimary ; asgo:verifiedWith "genai.owasp.org/llm-top-10" ; asgo:partOfFramework threat:OWASPLLMTop10-2025 ; asgo:identifier "LLM03:2025" ; rdfs:label "LLM03:2025 Supply Chain"@en ; asgo:addresses threat:SupplyChainCompromise .
threat:LLM04-2025 a asgo:FrameworkElement ; asgo:verificationStatus asgo:VerifiedPrimary ; asgo:verifiedWith "genai.owasp.org/llm-top-10" ; asgo:partOfFramework threat:OWASPLLMTop10-2025 ; asgo:identifier "LLM04:2025" ; rdfs:label "LLM04:2025 Data and Model Poisoning"@en ; asgo:addresses threat:PoisoningAttack .
threat:LLM05-2025 a asgo:FrameworkElement ; asgo:verificationStatus asgo:VerifiedPrimary ; asgo:verifiedWith "genai.owasp.org/llm-top-10" ; asgo:partOfFramework threat:OWASPLLMTop10-2025 ; asgo:identifier "LLM05:2025" ; rdfs:label "LLM05:2025 Improper Output Handling"@en ; asgo:addresses threat:ImproperOutputHandling .
threat:LLM06-2025 a asgo:FrameworkElement ; asgo:verificationStatus asgo:VerifiedPrimary ; asgo:verifiedWith "genai.owasp.org/llm-top-10" ; asgo:partOfFramework threat:OWASPLLMTop10-2025 ; asgo:identifier "LLM06:2025" ; rdfs:label "LLM06:2025 Excessive Agency"@en ; asgo:addresses threat:ExcessiveAgency .
threat:LLM07-2025 a asgo:FrameworkElement ; asgo:verificationStatus asgo:VerifiedPrimary ; asgo:verifiedWith "genai.owasp.org/llm-top-10" ; asgo:partOfFramework threat:OWASPLLMTop10-2025 ; asgo:identifier "LLM07:2025" ; rdfs:label "LLM07:2025 System Prompt Leakage"@en ; asgo:addresses threat:SystemPromptLeakage .
threat:LLM08-2025 a asgo:FrameworkElement ; asgo:verificationStatus asgo:VerifiedPrimary ; asgo:verifiedWith "genai.owasp.org/llm-top-10" ; asgo:partOfFramework threat:OWASPLLMTop10-2025 ; asgo:identifier "LLM08:2025" ; rdfs:label "LLM08:2025 Vector and Embedding Weaknesses"@en ; asgo:addresses threat:VectorEmbeddingWeakness .
threat:LLM09-2025 a asgo:FrameworkElement ; asgo:verificationStatus asgo:VerifiedPrimary ; asgo:verifiedWith "genai.owasp.org/llm-top-10" ; asgo:partOfFramework threat:OWASPLLMTop10-2025 ; asgo:identifier "LLM09:2025" ; rdfs:label "LLM09:2025 Misinformation"@en ; asgo:addresses nist:Confabulation .
threat:LLM10-2025 a asgo:FrameworkElement ; asgo:verificationStatus asgo:VerifiedPrimary ; asgo:verifiedWith "genai.owasp.org/llm-top-10" ; asgo:partOfFramework threat:OWASPLLMTop10-2025 ; asgo:identifier "LLM10:2025" ; rdfs:label "LLM10:2025 Unbounded Consumption"@en ; asgo:addresses threat:UnboundedConsumption .

# -----------------------------------------------------------------------------
# OWASP Top 10 for Agentic Applications 2026
# -----------------------------------------------------------------------------

threat:ASI01 a asgo:FrameworkElement ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "Two consistent secondary sources (official list is in the OWASP PDF)" ; asgo:partOfFramework threat:OWASPAgenticTop10 ; asgo:identifier "ASI01" ; rdfs:label "ASI01 Agent Goal Hijack"@en ; asgo:addresses threat:AgentGoalHijack , threat:PromptInjection .
threat:ASI02 a asgo:FrameworkElement ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "Two consistent secondary sources (official list is in the OWASP PDF)" ; asgo:partOfFramework threat:OWASPAgenticTop10 ; asgo:identifier "ASI02" ; rdfs:label "ASI02 Tool Misuse and Exploitation"@en ; asgo:addresses threat:ToolMisuse , threat:ExcessiveAgency .
threat:ASI03 a asgo:FrameworkElement ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "Two consistent secondary sources (official list is in the OWASP PDF)" ; asgo:partOfFramework threat:OWASPAgenticTop10 ; asgo:identifier "ASI03" ; rdfs:label "ASI03 Identity and Privilege Abuse"@en ; asgo:addresses threat:IdentityPrivilegeAbuse .
threat:ASI04 a asgo:FrameworkElement ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "Two consistent secondary sources (official list is in the OWASP PDF)" ; asgo:partOfFramework threat:OWASPAgenticTop10 ; asgo:identifier "ASI04" ; rdfs:label "ASI04 Agentic Supply Chain Vulnerabilities"@en ; asgo:addresses threat:SupplyChainCompromise , threat:AgentToolPoisoning .
threat:ASI05 a asgo:FrameworkElement ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "Two consistent secondary sources (official list is in the OWASP PDF)" ; asgo:partOfFramework threat:OWASPAgenticTop10 ; asgo:identifier "ASI05" ; rdfs:label "ASI05 Unexpected Code Execution (RCE)"@en ; asgo:addresses threat:UnexpectedCodeExecution .
threat:ASI06 a asgo:FrameworkElement ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "Two consistent secondary sources (official list is in the OWASP PDF)" ; asgo:partOfFramework threat:OWASPAgenticTop10 ; asgo:identifier "ASI06" ; rdfs:label "ASI06 Memory and Context Poisoning"@en ; asgo:addresses threat:MemoryContextPoisoning .
threat:ASI07 a asgo:FrameworkElement ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "Two consistent secondary sources (official list is in the OWASP PDF)" ; asgo:partOfFramework threat:OWASPAgenticTop10 ; asgo:identifier "ASI07" ; rdfs:label "ASI07 Insecure Inter-Agent Communication"@en ; asgo:addresses threat:InsecureInterAgentCommunication .
threat:ASI08 a asgo:FrameworkElement ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "Two consistent secondary sources (official list is in the OWASP PDF)" ; asgo:partOfFramework threat:OWASPAgenticTop10 ; asgo:identifier "ASI08" ; rdfs:label "ASI08 Cascading Failures"@en ; asgo:addresses threat:CascadingFailure .
threat:ASI09 a asgo:FrameworkElement ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "Two consistent secondary sources (official list is in the OWASP PDF)" ; asgo:partOfFramework threat:OWASPAgenticTop10 ; asgo:identifier "ASI09" ; rdfs:label "ASI09 Human-Agent Trust Exploitation"@en ; asgo:addresses threat:HumanAgentTrustExploitation .
threat:ASI10 a asgo:FrameworkElement ; asgo:verificationStatus asgo:CorroboratedSecondary ; asgo:verifiedWith "Two consistent secondary sources (official list is in the OWASP PDF)" ; asgo:partOfFramework threat:OWASPAgenticTop10 ; asgo:identifier "ASI10" ; rdfs:label "ASI10 Rogue Agents"@en ; asgo:addresses threat:RogueAgent .

# Controls that mitigate these threats are defined in ai-controls.ttl.
