@prefix asgo:     <https://w3id.org/asgo/core#> .
@prefix ctl:      <https://w3id.org/asgo/controls#> .
@prefix threat:   <https://w3id.org/asgo/threats#> .
@prefix nist:     <https://w3id.org/asgo/nist-ai-rmf#> .
@prefix csf:      <https://w3id.org/asgo/nist-csf#> .
@prefix euaia:    <https://w3id.org/asgo/eu-ai-act#> .
@prefix oecd:     <https://w3id.org/asgo/oecd-ai#> .
@prefix pk:       <https://w3id.org/asgo/practitioner#> .
@prefix src:      <https://w3id.org/asgo/sources#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .

# =============================================================================
# AI security control catalogue by deployment scope
# - Deployment scopes follow the public AWS Generative AI Security Scoping
#   Matrix (Scope 1 consumer app ... Scope 5 self-trained model).
# - MITRE ATLAS mitigations are taken from ATLAS data release v2026.09
#   (IDs and names verified against ATLAS-2026.09.yaml).
# - This file is the ONLY place where controls are defined and linked to
#   requirements (asgo:implements) and threats (asgo:mitigates).
# - Controls are generic security practice written in the ASGO author's words;
#   which control applies to which scope is practitioner judgement (GokceINFO).
# =============================================================================

<https://w3id.org/asgo/controls>
    a owl:Ontology ;
    owl:imports <https://w3id.org/asgo/threats> , <https://w3id.org/asgo/eu-ai-act> , <https://w3id.org/asgo/nist-ai-rmf-subcategories> , <https://w3id.org/asgo/nist-csf> , <https://w3id.org/asgo/oecd-ai> , <https://w3id.org/asgo/sources> ;
    dcterms:title "ASGO - AI security control catalogue by deployment scope"@en ;
    asgo:authorityLevel asgo:PractitionerInsight ;
    dcterms:creator "Gokcenur Yazici" ;
    dcterms:created "2026-10-01"^^xsd:date ;
    dcterms:source src:GokceINFO ;
    owl:versionInfo "0.1.0" .

ctl:AWSGenAIScopingMatrix a asgo:Framework ;
    rdfs:label "AWS Generative AI Security Scoping Matrix"@en ;
    asgo:identifier "AWS GenAI Scoping Matrix" ;
    asgo:authorityLevel asgo:Informative ;
    asgo:sourceURL "https://aws.amazon.com/ai/security/generative-ai-scoping-matrix/" ;
    rdfs:seeAlso <https://aws.amazon.com/blogs/security/securing-generative-ai-an-introduction-to-the-generative-ai-security-scoping-matrix/> ;
    asgo:publicationStatus asgo:Final ;
    asgo:statusCheckedOn "2026-10-01"^^xsd:date ;
    skos:note "Classifies generative AI use by ownership of the stack. Scopes 1-2 are 'buying', scopes 3-5 are 'building'. A companion Agentic AI Security Scoping Matrix also exists."@en .

# -----------------------------------------------------------------------------
# Deployment scopes
# -----------------------------------------------------------------------------

ctl:Scope1 a asgo:DeploymentScope ; asgo:scopeLevel 1 ;
    rdfs:label "Scope 1 - Consumer app"@en ;
    skos:definition "Use of a public third-party AI service under its standard terms; no access to model or training data, no ability to modify them. Buying."@en ;
    dcterms:source ctl:AWSGenAIScopingMatrix .

ctl:Scope2 a asgo:DeploymentScope ; asgo:scopeLevel 2 ;
    rdfs:label "Scope 2 - Enterprise app"@en ;
    skos:definition "Third-party enterprise application with AI features under an organisation-specific contract. Buying."@en ;
    dcterms:source ctl:AWSGenAIScopingMatrix .

ctl:Scope3 a asgo:DeploymentScope ; asgo:scopeLevel 3 ;
    rdfs:label "Scope 3 - Pre-trained model"@en ;
    skos:definition "Own application built on a third-party foundation model via API or locally hosted, without changing the model. Building."@en ;
    dcterms:source ctl:AWSGenAIScopingMatrix .

ctl:Scope4 a asgo:DeploymentScope ; asgo:scopeLevel 4 ;
    rdfs:label "Scope 4 - Fine-tuned model"@en ;
    skos:definition "A third-party foundation model fine-tuned with the organisation's data, creating a new model. Building."@en ;
    dcterms:source ctl:AWSGenAIScopingMatrix .

ctl:Scope5 a asgo:DeploymentScope ; asgo:scopeLevel 5 ;
    rdfs:label "Scope 5 - Self-trained model"@en ;
    skos:definition "A model trained from scratch on data the organisation owns or acquires; full ownership of the stack. Building."@en ;
    dcterms:source ctl:AWSGenAIScopingMatrix .

